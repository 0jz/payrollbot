# ── Anthropic ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Solana (devnet) ───────────────────────────────────────────
# Base-58 encoded private key of your payer wallet
SOLANA_PRIVATE_KEY=your_base58_private_key_here

# ── Gmail MCP ─────────────────────────────────────────────────
GMAIL_MCP_URL=https://gmailmcp.googleapis.com/mcp/v1
# OAuth2 Bearer token for the Gmail MCP endpoint
GMAIL_ACCESS_TOKEN=ya29...

# ── Agent fee wallet (optional) ──────────────────────────────
# Public key of a SEPARATE wallet that collects the 0.5% agent fee
# Leave blank to skip fee collection during testing
AGENT_WALLET=

# ── Human oversight ───────────────────────────────────────────
# PM email — receives approval requests and weekly digest
PM_EMAIL=you@example.com
# Payments above this amount require explicit PM approval (opt-in)
# Payments below this amount get a cancel window (opt-out)
MAX_AUTO_PAYMENT_USD=500
# Cancel window duration in ms before auto-payment executes (default 2 min)
CANCEL_WINDOW_MS=120000

# ── Optional tuning ───────────────────────────────────────────
# How often to poll Gmail (ms). Default: 30000
POLL_INTERVAL_MS=30000
# Max hours/week before anomaly flag
MAX_HOURS_THRESHOLD=60
# Rate deviation % before anomaly flag (0.20 = 20 %)
RATE_DEVIATION_THRESHOLD=0.20
